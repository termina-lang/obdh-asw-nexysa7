import drivers.char_dev;
import obdh.tmtc.tc_frame_receiver;
import obdh.tmtc.tm_frame_transmitter;
import obdh.pus.tc_handler;
import obdh.pus.tc_packet;

/** @brief Bytes of the longest TC frame, bound of the bytes read per interrupt */
constexpr tc_frame_max_size : usize = tm_frame_header_size + max_tc_size;

/**
 * @brief Interrupt handler of the character device that carries the TM/TC frames
 *
 * Lets the TM frame transmitter write its next bytes. Then reads the received
 * bytes, hands each one to the TC frame receiver and stops when there are none
 * left or a TC is complete, which it sends to the TC queue. The device raises
 * another interrupt for the bytes left.
 */
handler class CTMTCFrameIRQHandler {

    irq_entry : sink u32 triggers irq_handler;

    char_dev : access ICharDev;
    tc_frame_receiver : access ITCFrameReceiver;
    tm_frame_transmitter : access ITMFrameTransmitter;

    tc_message_queue_output : out box TCHandler;

    action irq_handler(&priv self, _vector : u32) {

        // Transmission
        self->tm_frame_transmitter.transmit();

        // Reception
        var received : bool = true;
        var complete : bool = false;

        for i : usize in 0 .. tc_frame_max_size while (received && complete == false) {

            var byte : Option<u8> = None;
            self->char_dev.read_byte(&mut byte);

            match byte {
                case Some(rx_byte) => {
                    self->tc_frame_receiver.receive(rx_byte, &mut complete);
                }
                case None => {
                    received = false;
                }
            }
        }

        var tc_handler : Option<box TCHandler> = None;
        self->tc_frame_receiver.take_tc(&mut tc_handler);

        match tc_handler {
            case Some(tc_handler_b) => {
                self->tc_message_queue_output.send(tc_handler_b);
            }
            case None => {
                // TC not complete yet
            }
        }

        return;
    }
};
