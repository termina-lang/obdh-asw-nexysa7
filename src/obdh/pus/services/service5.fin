/*
PUS SERVICE 5 : EVENT REPORTING
*/


import obdh.pus.services.service5.internal;


enum FaultInfo {
    ParamOutOfLimit(ParamOutOfLimitInfo),
    ParamFaultValue(ParamFaultValueInfo),
    Empty
};


interface IPUSService5 {

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);
    procedure is_Ev_ID_enabled_ext(&mut self, Ev_ID: u16, p_enabled: &mut bool);
    procedure send_tm_5_x(&mut self, evID: u16, fault_info: &FaultInfo);
    procedure send_tm_5_2(&mut self);

};

resource class CPUSService5 provides IPUSService5 {

    Ev_ID_enable_config : [u32; 4];

    /**
    * @brief Access to the telemetry (TM) channel interface.
    * 
    * Used to send telemetry packets generated by the service.
    */
    tm_channel : access ITMChannel;

    /**
    * @brief Allocator for TMHandler objects.
    * 
    * Provides dynamic memory management for telemetry handler instances.
    */
    tm_handler_pool : access Allocator<TMHandler>;

    /**
    * @brief Interface for the telemetry packet counter.
    * 
    * Provides sequential TM packet counters to ensure proper numbering of packets.
    */
    tm_counter : access ITMCounter;

    /**
    * @brief Access to the On-Board Time manager resource.
    * 
    * Provides time-related services such as obtaining the current onboard time (OBT)
    * used for timestamping telemetry packets.
    */
    obt_manager : access IOBTManager;

    pus_service_1 : access IPUSService1;

    method is_Ev_ID_enabled(&self, Ev_ID : u16) -> bool {

        var enabled : bool = false;
        var config_slot : usize = get_Ev_ID_enable_config_index(Ev_ID);
        var offset : u8 = get_Ev_ID_enable_config_offset(Ev_ID);

        if (config_slot != 0){

            var config_array_index : usize = config_slot - 1; 
            if(((self->Ev_ID_enable_config[config_array_index] >> (offset-1)) & 0x01) != 0){
                enabled = true;
            }
        }

        return enabled;
    }

    procedure is_Ev_ID_enabled_ext(&mut self, Ev_ID: u16, p_enabled: &mut bool) {

        *p_enabled = (self->is_Ev_ID_enabled(Ev_ID));

        return;
    }

    method exec5_5TC(&priv self, tc_request : &PS5TCRequest) -> Status<PUSService5Error> {

        var status : Status<PUSService5Error> = Success;

        var config_slot: usize = get_Ev_ID_enable_config_index(tc_request->EvID);
        var offset : u8 = get_Ev_ID_enable_config_offset(tc_request->EvID);

        if (tc_request->N != 1) {

            status = Failure(PUSService5Error::NumOfInstrNotValid(tc_request->N));

        } else if (config_slot == 0) {

            status = Failure(PUSService5Error::EvIDNotValid(tc_request->EvID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            let mask : u32 = 0x1 << (offset - 1);
            self->Ev_ID_enable_config[config_slot - 1] = self->Ev_ID_enable_config[config_slot - 1] | mask;

            self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

        }

        return status;

    }

    method exec5_6TC(&priv self, tc_request : &PS5TCRequest) -> Status<PUSService5Error> {

        var status : Status<PUSService5Error> = Success;

        var config_slot: usize = get_Ev_ID_enable_config_index(tc_request->EvID);
        var offset : u8 = get_Ev_ID_enable_config_offset(tc_request->EvID);

        if (tc_request->N != 1) {

            status = Failure(PUSService5Error::NumOfInstrNotValid(tc_request->N));

        } else if (config_slot == 0) {

            status = Failure(PUSService5Error::EvIDNotValid(tc_request->EvID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            let mask : u32 = 0x1 << (offset - 1);
            self->Ev_ID_enable_config[config_slot - 1] = self->Ev_ID_enable_config[config_slot - 1] & (0xFFFFFFFE ^ mask);

            self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

        }

        return status;

    }

    procedure send_tm_5_2(&mut self){

        var tm_handler : Option<box TMHandler> = None;
        self->tm_handler_pool.alloc(&mut tm_handler);

        match tm_handler {

            case Some(b_tm_handler) => {

                startup_tm(&mut b_tm_handler);
                let status : Status<TMHandlerError> = append_u16_appdata_field(&mut b_tm_handler, EvID_build_tm_error);

                if(status is Success){

                    var current_obt : CUCTime = {seconds = 0, finetime = 0};
                    var tm_count : u16 = 0 : u16;

                    self->tm_counter.get_next_tm_count(&mut tm_count);
                    self->obt_manager.get_current_obt(&mut current_obt);

                    close_tm(&mut b_tm_handler, 5, 2, tm_count, current_obt);

                    self->tm_channel.send_tm(b_tm_handler);

                }
                else {
                    self->tm_handler_pool.free(b_tm_handler);
                    self->tm_counter.count_lost_tm();
                }
            }
            case None => {
                self->tm_counter.count_lost_tm();

            }
        }
        return;

    }

    procedure send_tm_5_x(&mut self, evID: u16, fault_info: &FaultInfo){

        var tm_handler : Option<box TMHandler> = None;
        self->tm_handler_pool.alloc(&mut tm_handler);

        match tm_handler {

            case Some(b_tm_handler) => {

                var current_obt : CUCTime = {seconds = 0, finetime = 0};
                var tm_count : u16 = 0 : u16;

                self->tm_counter.get_next_tm_count(&mut tm_count);
                self->obt_manager.get_current_obt(&mut current_obt);

                var status : Status<TMHandlerError> = Success;

                match (*fault_info) {
                    case ParamOutOfLimit(fault_value_info) => {
                        status = build_tm_5_x_param_out_of_limit(&mut b_tm_handler, tm_count, fault_value_info, evID, current_obt);
                    }
                    case ParamFaultValue(fault_value_info) => {
                        status = build_tm_5_x_param_check_value_fail(&mut b_tm_handler, tm_count, fault_value_info, evID, current_obt);
                    }
                    case Empty => {

                    }
                }

                if(status is Success){
                    self->tm_channel.send_tm(b_tm_handler);
                } else {
                    self->tm_handler_pool.free(b_tm_handler);
                    self->tm_counter.count_lost_tm();
                }

            }
            case None => {
                self->tm_counter.count_lost_tm();
            }
        }

        return;
    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler){

        var status : Status<PUSService5Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS5TCRequest = ps5_init_tc_request;

        tc_request.packet_id = tc_handler->packet_header.packet_id;
        tc_request.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;
        var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.N));

        if (tc_data_status is Success){
            tc_data_status = tc_handler_get_u16_appdata_field(tc_handler, &mut (tc_request.EvID));
        }

        if (tc_data_status is Failure) {
            status = Failure(PUSService5Error::AppDataOutOfRange(tc_request.tc_num_bytes));
        }

        if (status is Success) {

            if (subtype == 5) {

                status = self->exec5_5TC(&tc_request);

            } else if (subtype == 6) {

                status = self->exec5_6TC(&tc_request);

            } else {

                status = Failure(PUSService5Error::ErrorInAcceptance);
            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    tc_num_bytes);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    N);

                    }
                    case EvIDNotValid(EvID) => {

                        self->pus_service_1.send_tm_1_4_EvID_not_valid(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    EvID);

                    }
                }

            }
        }

        return;

    }
  
};



