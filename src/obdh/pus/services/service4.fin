/*
PUS SERVICE 4 : PARAMETER STATISTICS REPORTING
*/

import obdh.pus.services.service4.internal;
import obdh.system_data_pool;

interface IPUSService4 {

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);
    procedure update_all_stats(&mut self);
    procedure startup(&mut self);
    
};

resource class CPUSService4 provides IPUSService4 {

    param_stats : [StatsDef; max_num_of_stats];
    stats_config_table : StatsConfig;

    system_data_pool_u32 : access AtomicArrayAccess<u32; sdp_num_u32_params>;
    system_data_pool_u8 : access AtomicArrayAccess<u8; sdp_num_u8_params>;

    tm_channel: access ITMChannel;   
    tm_handler_pool : access Allocator<TMHandler>;
    tm_counter : access ITMCounter;

    obt_manager : access IOBTManager;

    pus_service_1 : access IPUSService1;

    method get_PID_defined_stats_index (&priv self, tc_request : &mut PS4TCRequest) -> Status<PUSService4Error> {

        var status : Status<PUSService4Error> = Failure(PUSService4Error::PIDStatsUndefined(tc_request->PID));

        for i : usize in 0 .. max_num_of_stats while (status is Failure) {

            if(tc_request->PID == self->stats_config_table.PID[i]) {

                if (self->stats_config_table.defined[i] == true) {

                    if(sys_data_pool_is_valid_PID(tc_request->PID)) {

                        tc_request->valid_index = i;
                        status = Success;
                        
                    } else {
                        self->stats_config_table.defined[i] = false;
                    
                    }
                }

            }
        }
        return status;
    }

    method get_free_index (&self, tc_request : &PS4TCRequest) -> IndexStatus {

        var id_status: IndexStatus = {index = 0, status = Failure(PUSService4Error::NotFreeStatsConfig(tc_request->PID))};

        for i : usize in 0 .. max_num_of_stats while (id_status.status is Failure) {

            var pid_is_valid : bool = sys_data_pool_is_valid_PID(self->stats_config_table.PID[i]);

            if ((self->stats_config_table.defined[i] == false) || (pid_is_valid == false)) {

                id_status.index = i; 
                id_status.status = Success;
            }
        }
        return id_status;
    }

    method is_stats_index_defined(&self, stats_index: usize) -> bool {

        var is_defined: bool = false;

        if(stats_index < max_num_of_stats){

            if (self->stats_config_table.defined[stats_index] == true) {

                if(sys_data_pool_is_valid_PID(self->stats_config_table.PID[stats_index])) {

                    is_defined = true;

                } else {

                }
            }
        }

        return is_defined;
    }

    method add_PID_stats (&priv self, tc_request : &mut PS4TCRequest) -> Status<PUSService4Error> {

        var index_status : IndexStatus = {index = 0, status = Success};
        var status : Status<PUSService4Error> = self->get_PID_defined_stats_index(tc_request);

        if(status is Failure) {

            index_status = self->get_free_index(&(*tc_request));
            tc_request->valid_index = index_status.index;
        }

        if(index_status.status is Success) {

            var PID_index: usize = tc_request->valid_index;

            self->stats_config_table.defined[PID_index] = true;
            self->stats_config_table.PID[PID_index] = tc_request->PID;

            self->param_stats[PID_index].samples = 0;
            var current_obt : CUCTime = {seconds = 0, finetime = 0};
            self->obt_manager.get_current_obt(&mut current_obt);
            self->stats_config_table.start_time[PID_index] = current_obt;
            status = Success;
            
        } else {

            status = Failure(PUSService4Error::NotFreeStatsConfig(tc_request->PID));
        }

        return status;
    }

    method delete_PID_stats (&priv self, tc_request : &mut PS4TCRequest) -> Status<PUSService4Error> {

        var status : Status<PUSService4Error> = self->get_PID_defined_stats_index(tc_request);

        if (status is Success) {
            self->stats_config_table.defined[tc_request->valid_index] = false;
        }

        return status;
        
    }

// TC[4,1] : Report the parameter statistics
    method exec4_1TC(&priv self, tc_request : &PS4TCRequest) -> Status<PUSService4Error> {

        var status : Status<PUSService4Error> = Success;

        self->pus_service_1.notify_tm_1_3(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

        for i : usize in 0 .. max_num_of_stats {

            if (self->stats_config_table.defined[i] == true) {

                var tm_handler : Option<box TMHandler> = None;
                self->tm_handler_pool.alloc(&mut tm_handler);

                match tm_handler {

                    case Some(b_tm_handler) => {

                        var current_obt : CUCTime = {seconds = 0, finetime = 0};
                        var tm_count : u16 = 0 : u16;
                        
                        self->tm_counter.get_next_tm_count(&mut tm_count);
                        self->obt_manager.get_current_obt(&mut current_obt);

                        let tm_status : Status<TMHandlerError> = build_tm_4_2(&mut b_tm_handler, tm_count, i, 1, &(self->stats_config_table), &(self->param_stats), current_obt);

                        if (tm_status is Success){

                            self->tm_channel.send_tm(b_tm_handler);

                        }
                        else {
                            self->tm_handler_pool.free(b_tm_handler);
                            self->tm_counter.count_lost_tm();
                        }
                        
                        //reset_stats_index
                        self->param_stats[i].samples = 0;
                        var current_obt_update : CUCTime = {seconds = 0, finetime = 0};
                        self->obt_manager.get_current_obt(&mut current_obt_update);
                        self->stats_config_table.start_time[i] = current_obt_update;
                    }
                    case None => {
                        self->tm_counter.count_lost_tm();
                    }
                }
            }
        }

        self->pus_service_1.notify_tm_1_7(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

        return status;
    }

// TC[4,6] : Add or update parameter statistics definitions
    method exec4_6TC(&priv self, tc_request : &mut PS4TCRequest) -> Status<PUSService4Error> {

        var status : Status<PUSService4Error>;

        if (tc_request->N != 1) {

            status = Failure(PUSService4Error::NumOfInstrNotValid(tc_request->N));

        } else if (sys_data_pool_is_valid_PID(tc_request->PID) == false) {

            status = Failure(PUSService4Error::PIDNotValid(tc_request->PID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            status = self->add_PID_stats(tc_request);

            if (status is Success) {

                self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            }

        }

        return status;
    }

// TC[4,7] : Delete parameter statistics definitions
    method exec4_7TC(&priv self, tc_request : &mut PS4TCRequest) -> Status<PUSService4Error> {

        var status : Status<PUSService4Error>;

        if (tc_request->N != 1) {

            status = Failure(PUSService4Error::NumOfInstrNotValid(tc_request->N));

        } else if (sys_data_pool_is_valid_PID(tc_request->PID) == false) {

            status = Failure(PUSService4Error::PIDNotValid(tc_request->PID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

            status = self->delete_PID_stats(tc_request);

            if (status is Success) {

                self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            }
        }

        return status;
    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler){

        var status : Status<PUSService4Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS4TCRequest = ps4_init_tc_request;

        tc_request.packet_id = tc_handler->packet_header.packet_id;
        tc_request.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;

        if (subtype == 6 || subtype == 7) {

            var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.N));
            if (tc_data_status is Success){
                tc_data_status = tc_handler_get_u16_appdata_field(tc_handler, &mut (tc_request.PID));
            }

            if (tc_data_status is Failure) {
                status = Failure(PUSService4Error::AppDataOutOfRange(tc_request.tc_num_bytes));
            }

        }

        if (status is Success) {

            if (subtype == 1) {

                status = self->exec4_1TC(&tc_request);

            } else if (subtype == 6) {

                status = self->exec4_6TC(&mut tc_request);

            } else if (subtype == 7) {

                status = self->exec4_7TC(&mut tc_request);

            } else {

                status = Failure(PUSService4Error::ErrorInAcceptance);
            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                tc_num_bytes);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                N);

                    }
                    case PIDNotValid(PID) => {

                        self->pus_service_1.send_tm_1_4_PID_not_valid(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                PID);

                    }
                    case PIDStatsUndefined(PID) => {

                        self->pus_service_1.send_tm_1_4_PID_stats_undefined(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                PID);

                    }
                    case NotFreeStatsConfig(PID) => {

                        self->pus_service_1.send_tm_1_8_not_free_stats_config(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                PID);

                    }
                }

            }
        }

        return;
    
    }

    method SDP_param_higher_than_limit(&self, pid_index : usize) -> bool {

        var is_higher : bool = false;
        var PID : u16 = self->stats_config_table.PID[pid_index];

        var item_type : DataPoolItem = sys_data_pool_get_item(PID);

        match item_type {
            case U8Item(sdp_index) => {
                var u8_SDP_value : u8 = 0;
                self->system_data_pool_u8.load_index(sdp_index, &mut u8_SDP_value);
                if ((u8_SDP_value as u32) > self->param_stats[pid_index].max) {
                    is_higher = true;
                }
            }
            case U32Item(sdp_index) => {
                var u32_SDP_value : u32 = 0;
                self->system_data_pool_u32.load_index(sdp_index, &mut u32_SDP_value);
                if (u32_SDP_value > self->param_stats[pid_index].max) {
                    is_higher = true;
                }
            }
            case NoValidPID => {
                //Error
            }
        }

        return is_higher;
    }


    method SDP_param_lower_than_limit(&self, pid_index : usize) -> bool {

        var is_lower : bool = false;
        var PID : u16 = self->stats_config_table.PID[pid_index];

        var item_type : DataPoolItem = sys_data_pool_get_item(PID);

        match item_type {
            case U8Item(sdp_index) => {
                var u8_SDP_value : u8 = 0;
                self->system_data_pool_u8.load_index(sdp_index, &mut u8_SDP_value);
                if ((u8_SDP_value as u32) < self->param_stats[pid_index].min) {
                    is_lower = true;
                }
            }
            case U32Item(sdp_index) => {
                var u32_SDP_value : u32 = 0;
                self->system_data_pool_u32.load_index(sdp_index, &mut u32_SDP_value);
                if (u32_SDP_value < self->param_stats[pid_index].min) {
                    is_lower = true;
                }
            }
            case NoValidPID => {
                //Error
            }
        }

        return is_lower;
    }

    method get_data_pool_item(&self, PID: u16 ) -> u32 {

        var item_type : DataPoolItem = sys_data_pool_get_item(PID);
        var SDP_value : u32 = 0;

        match item_type {
            case U8Item(sdp_index) => {
                var aux_value: u8 = 0;
                self->system_data_pool_u8.load_index(sdp_index, &mut aux_value);
                SDP_value = aux_value as u32;
            }
            case U32Item(sdp_index) => {
                self->system_data_pool_u32.load_index(sdp_index, &mut SDP_value);
            }
            case NoValidPID => {
                //Error
            }
        }
        return SDP_value;

    }


    method SDP_get_mean(&self, pid_index : usize) -> u32 {

        var PID : u16 = self->stats_config_table.PID[pid_index];
        var mean_value : u32 = 0;

        var item_type : DataPoolItem = sys_data_pool_get_item(PID);

        match item_type {
            case U8Item(sdp_index) => {
                var u8_SDP_value : u8 = 0;
                self->system_data_pool_u8.load_index(sdp_index, &mut u8_SDP_value);
                mean_value = ((self->param_stats[pid_index].mean_value * self->param_stats[pid_index].samples) + (u8_SDP_value as u32)) / (self->param_stats[pid_index].samples + 1);
            }
            case U32Item(sdp_index) => {
                var u32_SDP_value : u32 = 0;
                self->system_data_pool_u32.load_index(sdp_index, &mut u32_SDP_value);
                mean_value = ((self->param_stats[pid_index].mean_value * self->param_stats[pid_index].samples) + u32_SDP_value) / (self->param_stats[pid_index].samples + 1);
            }
            case NoValidPID => {
                //Error
            }
        }

        return mean_value;
    }

    procedure update_all_stats(&mut self) {

        for i : usize in 0 .. max_num_of_stats {

            if(self->is_stats_index_defined(i) == true) {

                var PID : u16 = self->stats_config_table.PID[i];

                if(self->param_stats[i].samples > 0){

                    if(self->SDP_param_higher_than_limit(i) == true) {

                        var system_data_pool_item : u32 = self->get_data_pool_item(PID);
                        self->param_stats[i].max = system_data_pool_item;
                        var current_time : CUCTime = {
                            seconds = 0,
                            finetime = 0
                        };
                        self->obt_manager.get_current_obt(&mut current_time);
                        self->param_stats[i].max_obt = current_time;


                    } else if (self->SDP_param_lower_than_limit(i) == true) {

                        var system_data_pool_item : u32 = self->get_data_pool_item(PID);
                        self->param_stats[i].min = system_data_pool_item;
                        var current_time : CUCTime = {
                            seconds = 0,
                            finetime = 0
                        };
                        self->obt_manager.get_current_obt(&mut current_time);
                        self->param_stats[i].min_obt = current_time;

                    } else {

                    }

                    self->param_stats[i].mean_value = self->SDP_get_mean(i);

                }
                else {

                    var system_data_pool_item : u32 = self->get_data_pool_item(PID);
                    self->param_stats[i].max = system_data_pool_item;
                    self->param_stats[i].min = system_data_pool_item;
                    self->param_stats[i].mean_value = system_data_pool_item;
                    var current_time : CUCTime = {
                        seconds = 0,
                        finetime = 0
                    };
                    self->obt_manager.get_current_obt(&mut current_time);
                    self->param_stats[i].max_obt = current_time;
                    self->param_stats[i].min_obt = current_time;
                    
                    
                }

                self->param_stats[i].samples = self->param_stats[i].samples + 1;

                
            } else {
                
                self->stats_config_table.defined[i] = false;
                
            }


        }

        return;
    }


    procedure startup(&mut self){

        for i : usize in 0 .. max_num_of_stats {

            if(self->is_stats_index_defined(i) == true) {

                self->param_stats[i].samples = 0;
                var current_obt : CUCTime = {seconds = 0, finetime = 0};
                self->obt_manager.get_current_obt(&mut current_obt);
                self->stats_config_table.start_time[i] = current_obt;

            }
            else {
                self->stats_config_table.defined[i] = false;
            }
            
        }

        return;
    }

};