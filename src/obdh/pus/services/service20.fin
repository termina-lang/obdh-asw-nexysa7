/*
PUS SERVICE 20 : PARAMETER MANAGEMENT
*/

import obdh.pus.services.service20.types;

interface IPUSService20 {
    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);
};

resource class CPUSService20 provides IPUSService20 {

    system_data_pool_u32 : access AtomicArrayAccess<u32; sdp_num_u32_params>;
    system_data_pool_u8 : access AtomicArrayAccess<u8; sdp_num_u8_params>;

    tm_channel: access ITMChannel;   
    tm_handler_pool : access Allocator<TMHandler>;
    tm_counter : access ITMCounter;

    obt_manager : access IOBTManager;

    pus_service_1 : access IPUSService1;

    method exec20_1TC(&priv self, tc_request : &PS20TCRequest) -> Status<PUSService20Error> {

        var status : Status<PUSService20Error> = Success;

        if (tc_request->N != 1) {

            status = Failure(PUSService20Error::NumOfInstrNotValid(tc_request->N));

        } else if (sys_data_pool_is_valid_PID(tc_request->PID) == false) {

            status = Failure(PUSService20Error::PIDNotValid(tc_request->PID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

            var tm_handler : Option<box TMHandler> = None;
            self->tm_handler_pool.alloc(&mut tm_handler);

            match tm_handler {

                case Some(b_tm_handler) => {

                    var current_obt : CUCTime = {seconds = 0, finetime = 0};
                    var tm_count : u16 = 0 : u16;

                    self->tm_counter.get_next_tm_count(&mut tm_count);

                    startup_tm(&mut b_tm_handler);

                    var tm_status : Status<TMHandlerError> = append_u8_appdata_field(&mut b_tm_handler, 1);
                    var valid_PID : bool = true;

                    if (tm_status is Success){
                        tm_status = append_u16_appdata_field(&mut b_tm_handler, (tc_request->PID) as u16);
                    }

                    if (tm_status is Success){
                        var item_type : DataPoolItem = sys_data_pool_get_item((tc_request->PID));

                        match item_type {
                            case U8Item(sdp_index) => {
                                var u8_SDP_value : u8 = 0;
                                self->system_data_pool_u8.load_index(sdp_index, &mut u8_SDP_value);
                                tm_status = append_u8_appdata_field(&mut b_tm_handler, u8_SDP_value);
                            }
                            case U32Item(sdp_index) => {
                                var u32_SDP_value : u32 = 0;
                                self->system_data_pool_u32.load_index(sdp_index, &mut u32_SDP_value);
                                tm_status = append_u32_appdata_field(&mut b_tm_handler, u32_SDP_value);
                            }
                            case NoValidPID => {
                                valid_PID = false;
                            }
                        }
                    }

                    self->obt_manager.get_current_obt(&mut current_obt);

                    if ((tm_status is Success) && valid_PID){
                        close_tm(&mut b_tm_handler, 20, 2, tm_count, current_obt);
                        self->tm_channel.send_tm(b_tm_handler);
                    } else {
                        self->tm_handler_pool.free(b_tm_handler);
                        self->tm_counter.count_lost_tm();
                    }

                }
                case None => {

                    self->tm_counter.count_lost_tm();

                }
            }

            self->pus_service_1.notify_tm_1_7(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

        }

        return status;
    }



    method exec20_3TC(&priv self, tc_request : &PS20TCRequest) -> Status<PUSService20Error> {

        var status : Status<PUSService20Error> = Success;

        if (tc_request->N != 1) {

            status = Failure(PUSService20Error::NumOfInstrNotValid(tc_request->N));

        } else if (sys_data_pool_is_valid_PID(tc_request->PID) == false) {

            status = Failure(PUSService20Error::PIDNotValid(tc_request->PID));

        } else if (sys_data_pool_is_PID_update_via_TC_enabled(tc_request->PID) == false) {

            status = Failure(PUSService20Error::PIDReadOnlyViaTC(tc_request->PID));

        } else {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            var item_type : DataPoolItem = sys_data_pool_get_item(tc_request->PID);

            match item_type {
                case U8Item(sdp_index) => {
                    self->system_data_pool_u8.store_index(sdp_index, tc_request->tc_20_3_data.PID_value_u8);
                }
                case U32Item(sdp_index) => {
                    self->system_data_pool_u32.store_index(sdp_index, tc_request->tc_20_3_data.PID_value_u32);
                }
                case NoValidPID => {
                    status = Failure(PUSService20Error::PIDNotValid(tc_request->PID));
                }
            }

            if (status is Success) {

                self->pus_service_1.notify_tm_1_7(
                            tc_request->packet_id,
                            tc_request->packet_seq_ctrl,
                            tc_request->flags_ack);

            }

        }

        return status;

    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler) {

        var status : Status<PUSService20Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS20TCRequest = ps20_init_tc_request;

        tc_request.packet_id = tc_handler->packet_header.packet_id;
        tc_request.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;

        var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.N));

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u16_appdata_field(tc_handler, &mut (tc_request.PID));
        }

        if ((tc_data_status is Success) && subtype == 3) {

            var item_type : DataPoolItem = sys_data_pool_get_item(tc_request.PID);

            match item_type {
                case U8Item(_sdp_index) => {
                    tc_data_status = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.tc_20_3_data.PID_value_u8));
                }
                case U32Item(_sdp_index) => {
                    tc_data_status = tc_handler_get_u32_appdata_field(tc_handler, &mut (tc_request.tc_20_3_data.PID_value_u32));
                }
                case NoValidPID => {
                    status = Failure(PUSService20Error::PIDNotValid(tc_request.PID));
                }
            }

        }

        if (tc_data_status is Failure) {
            status = Failure(PUSService20Error::AppDataOutOfRange(tc_request.tc_num_bytes));
        }

        if (status is Success) {

            if (subtype == 1) {

                status = self->exec20_1TC(&tc_request);

            } else if (subtype == 3) {

                status = self->exec20_3TC(&tc_request);

            } else {

                status = Failure(PUSService20Error::ErrorInAcceptance);

            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    tc_num_bytes);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    N);

                    }
                    case PIDNotValid(PID) => {

                        self->pus_service_1.send_tm_1_4_PID_not_valid(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    PID);

                    }
                    case PIDReadOnlyViaTC(PID) => {

                        self->pus_service_1.send_tm_1_4_PID_read_only_via_TC(
                                    tc_request.packet_id,
                                    tc_request.packet_seq_ctrl,
                                    PID);

                    }
                }

            }
        }

        return;
    
    }

};