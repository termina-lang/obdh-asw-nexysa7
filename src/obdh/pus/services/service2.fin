/*
PUS SERVICE 2 : DEVICE ACCESS
*/

import drivers.gpio;
import obdh.pus.services.service1;
import encoding.binary;
import obdh.pus.tc_packet;
import obdh.pus.tm_packet;
import obdh.pus.services.service2.types;
import obdh.pus.services.service12;


// Device address: device index in bits 28 to 31, 1 (on) or 0 (off) in bits
// 0 to 3, the rest 0. The pin of each device is given by app.fin.

interface IPUSService2 {

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);

};


resource class CPUSService2 provides IPUSService2 {

    pus_service_1 : access IPUSService1;

    gpio : access IGPIO;

    /// Pin of each device, indexed by the device index of its address; None if there is no such device
    device_pins : [Option<GPIOPinId>; max_num_devices];

    method is_device_address_valid(&self, dev_address : u32) -> bool {

        var is_valid : bool = false;

        if ((dev_address & 0x0FFFFFFE : u32) == 0 : u32) {

            let device : usize = ((dev_address & 0xF0000000 : u32) >> 28 : u32) as usize;

            match self->device_pins[device] {
                case Some(_pin) => {
                    is_valid = true;
                }
                case None => {
                }
            }
        }

        return is_valid;
    }

    method exec2_1TC(&mut self, tc_request : &PS2TCRequest) -> Status<PUSService2Error> {

        var status : Status<PUSService2Error> = Success;

        if tc_request->N != 1 {

            status = Failure(PUSService2Error::NumOfInstrNotValid(tc_request->N));

        } else if self->is_device_address_valid(tc_request->dev_address) == false {

            status = Failure(PUSService2Error::DeviceAddressNotValid(tc_request->dev_address));

        } else {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            self->dev_drv_on_off(tc_request);

            self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

        }

        return status;
    }

    method dev_drv_on_off(&priv self, tc_request: &PS2TCRequest) {

        let device : usize = ((tc_request->dev_address & 0xF0000000 : u32) >> 28 : u32) as usize;

        match self->device_pins[device] {
            case Some(pin) => {
                if ((tc_request->dev_address & 0x00000001 : u32) == 0 : u32) {
                    self->gpio.write_pin(pin, GPIOPinState::Low);
                } else {
                    self->gpio.write_pin(pin, GPIOPinState::High);
                }
            }
            case None => {
            }
        }

        return;
    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler){

        var status : Status<PUSService2Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS2TCRequest = ps2_init_tc_request;

        tc_request.packet_id = tc_handler->packet_header.packet_id;
        tc_request.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;

        var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut tc_request.N);

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u32_appdata_field(tc_handler, &mut tc_request.dev_address);
        }

        if (tc_data_status is Failure) {
            status = Failure(PUSService2Error::AppDataOutOfRange(tc_request.tc_num_bytes));
        }

        if (status is Success) {

            if (subtype == 1) {

                status = self->exec2_1TC(&tc_request);

            } else {

                status = Failure(PUSService2Error::ErrorInAcceptance);
            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                        tc_request.packet_id,
                                        tc_request.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                        tc_request.packet_id,
                                        tc_request.packet_seq_ctrl,
                                        tc_num_bytes);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                        tc_request.packet_id,
                                        tc_request.packet_seq_ctrl,
                                        N);

                    }
                    case DeviceAddressNotValid(dev_address) => {

                        self->pus_service_1.send_tm_1_4_device_address_not_valid(
                                        tc_request.packet_id,
                                        tc_request.packet_seq_ctrl,
                                        dev_address);

                    }
                }

            }
        }

        return;
    
    }

};
