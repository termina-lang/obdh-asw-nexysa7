/**
 * @file pus_service3_help.fin
 * @brief Imports and definitions related to PUS Service 3.
 */

import obdh.system_data_pool;
import obdh.pus.services.service1;
import obdh.pus.services.service5;
import obdh.obt_manager;
import random.lcg;


constexpr max_num_of_SIDs : usize = 8;
constexpr max_params_per_SID : usize = 16;

struct IndexFound {
    found : bool;
    index : usize;
};

/**
 * @struct PS3TCRequest
 * @brief Fields of a TC[3,x] that its execution needs, decoded by exec_tc.
 */
struct PS3TCRequest {
    packet_id : u16;
    packet_seq_ctrl : u16;
    flags_ack : u8;
    tc_num_bytes : usize;
    N : u8;
    SID: u16;
    collection_interval : u8;
};

/**
 * @enum PUSService3Error
 * @brief Reasons why PUS service 3 rejects a TC, with the data of the TM[1,4] that reports each one.
 */
enum PUSService3Error {
    ErrorInAcceptance,          /**< Subtype not supported */
    AppDataOutOfRange(usize),   /**< TC shorter than its fields, with its length in bytes */
    NumOfInstrNotValid(u8),     /**< Number of instructions other than 1 */
    SIDNotValid(u16)            /**< SID not defined */
};

constexpr ps3_init_tc_request : PS3TCRequest  = {
    packet_id = 0, packet_seq_ctrl = 0, flags_ack = 0, tc_num_bytes = 0, N = 0, SID = 0, collection_interval = 0
};

struct HKConfiguration {
    enabled : bool;
    SID : u16;
    interval : u8;
    interval_control : u8;
    num_params : u8;
    params_def : [u16; max_params_per_SID];
};