/*
PUS SERVICE 19 : EVENT-ACTION
*/

import obdh.pus.services.service19.types;

interface IPUSService19 {

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);
    procedure manage_event_action(&mut self, evID: u16);
    procedure get_pending_action_number(&mut self, paction_num : &mut[usize;4]);
    procedure extract_action (&mut self, action_index : usize, action_packet : &mut TCHandler);
    
};

resource class CPUSService19 provides IPUSService19 {

    event_action_config : [EventActionConfig; max_event_action_definitions];
    event_action_packets : [TCHandler; max_event_action_definitions];
   
    pending_action_queue_1I : [TCHandler; event_action_queue_dimension];
    pending_action_queue_2LS : [TCHandler; event_action_queue_dimension];
    pending_action_queue_3MS : [TCHandler; event_action_queue_dimension];
    pending_action_queue_4HS : [TCHandler; event_action_queue_dimension];
    
    pending_action_number : [usize; 4];
    pending_action_head : [usize; 4];

    pus_service_1 : access IPUSService1;

    method disable_event_action (&priv self, ev_action_index : usize) {

        self->event_action_config[ev_action_index].enabled = false;

        return;
    }

    method enable_event_action (&priv self, ev_action_index : usize) {

        self->event_action_config[ev_action_index].enabled = true;

        return;
    }

    method delete_event_action (&priv self, ev_action_index : usize) {

        self->event_action_config[ev_action_index].event_ID = 0;
        self->event_action_config[ev_action_index].enabled = false;

        return;
    }

    method get_free_event_action_index (&self)-> FoundID {

        var found_and_id: FoundID = {found = false, ev_action_index = 0, enabled = false};

        for i : usize in 0 .. max_event_action_definitions while found_and_id.found == false {

            if (self->event_action_config[i].event_ID == 0) {

                found_and_id.ev_action_index = i;
                found_and_id.found = true;
            }
        }
        return found_and_id;
    }

    method is_ev_action_defined (&self, evID : u16) -> FoundID {

        var found_and_id: FoundID = {found = false, ev_action_index = 0, enabled = false};

        for i : usize in 0 .. max_event_action_definitions while found_and_id.found == false {

            if (self->event_action_config[i].event_ID == evID) {

                found_and_id.ev_action_index = i;
                found_and_id.enabled = self->event_action_config[i].enabled;
                found_and_id.found = true;
            }
        }
        return found_and_id;

    }


    //TC[19,1] allows the addition of event-action definitions
    method exec19_1TC (&priv self, tc_request : &mut PS19TCRequest) -> Status<PUSService19Error> {

        var status : Status<PUSService19Error> = Success;

        if (tc_request->tc_data.N != 1) {

            status = Failure(PUSService19Error::NumOfInstrNotValid(tc_request->tc_data.N));

        } else if (is_Ev_ID_valid(tc_request->tc_data.EvID) == false) {

            status = Failure(PUSService19Error::EvIDNotValid(tc_request->tc_data.EvID));

        } else {

            var error: TC19_1_Error;

            tc_request->ev_action_ID = self->is_ev_action_defined(tc_request->tc_data.EvID);

            if (tc_request->ev_action_ID.found) {

                if (tc_request->ev_action_ID.enabled){

                    error = TC19_1_Error::EvIDEnabled;
                }
                else {

                    error = TC19_1_Error::NoError;
                }

            } else {

                tc_request->ev_action_ID = self->get_free_event_action_index();

                if(tc_request->ev_action_ID.found){
                    error = TC19_1_Error::NoError;
                }
                else {
                    error = TC19_1_Error::MaxEventActionDefinitions;
                }
            }

            match error {

                case NoError => {

                    var action_tc_handler : TCHandler = {
                        tc_descriptor = tc_request->action_tc_packet,
                        packet_header = {
                            packet_id = 0,
                            packet_seq_ctrl = 0,
                            packet_length = 0
                        },
                        df_header = {
                            flag_ver_ack = 0,
                            type = 0,
                            subtype = 0,
                            sourceID = 0
                        },
                        packet_error_ctrl = 0,
                        app_data_index = 0
                    };
                    
                    tc_handler_build(&mut action_tc_handler);
                
                    var tc_status : TCStatus = try_tc_acceptation(&(tc_request->action_tc_packet));

                    if (tc_status.acceptation_status is TCAcceptationStatus::Accepted) {

                        self->pus_service_1.notify_tm_1_3(
                                tc_request->tc_data.packet_id,
                                tc_request->tc_data.packet_seq_ctrl,
                                tc_request->tc_data.flags_ack);

                        self->event_action_config[tc_request->ev_action_ID.ev_action_index].event_ID = tc_request->tc_data.EvID;
                        self->event_action_config[tc_request->ev_action_ID.ev_action_index].enabled = false;
                        self->event_action_packets[tc_request->ev_action_ID.ev_action_index] = action_tc_handler;

                        self->pus_service_1.notify_tm_1_7(
                                tc_request->tc_data.packet_id,
                                tc_request->tc_data.packet_seq_ctrl,
                                tc_request->tc_data.flags_ack);

                    } else {

                        status = Failure(PUSService19Error::EvActionRejected(tc_request->tc_data.EvID));

                    }

                }
                case EvIDEnabled => {

                    status = Failure(PUSService19Error::EvActionEnabled(tc_request->tc_data.EvID));

                }
                case MaxEventActionDefinitions => {

                    status = Failure(PUSService19Error::MaxEvActionsDefined(tc_request->tc_data.EvID));

                }
            }
                   
        }

        return status;
    }

//TC[19,2] allows the deletion of event-action definitions
    method exec19_2TC (&priv self, tc_request : &mut PS19TCRequest) -> Status<PUSService19Error> {

        var status : Status<PUSService19Error>;

        if (tc_request->tc_data.N != 1) {

            status = Failure(PUSService19Error::NumOfInstrNotValid(tc_request->tc_data.N));

        } else if (is_Ev_ID_valid(tc_request->tc_data.EvID) == false) {

            status = Failure(PUSService19Error::EvIDNotValid(tc_request->tc_data.EvID));

        } else {

            tc_request->ev_action_ID =
                    self->is_ev_action_defined(tc_request->tc_data.EvID);

            if (tc_request->ev_action_ID.found) {

                if (tc_request->ev_action_ID.enabled) {

                    status = Failure(PUSService19Error::EvActionEnabled(tc_request->tc_data.EvID));

                } else {

                    self->pus_service_1.notify_tm_1_3(
                            tc_request->tc_data.packet_id,
                            tc_request->tc_data.packet_seq_ctrl,
                            tc_request->tc_data.flags_ack);

                    self->delete_event_action(tc_request->ev_action_ID.ev_action_index);

                    self->pus_service_1.notify_tm_1_7(
                            tc_request->tc_data.packet_id,
                            tc_request->tc_data.packet_seq_ctrl,
                            tc_request->tc_data.flags_ack);

                    status = Success;

                }

            } else {

                status = Failure(PUSService19Error::EvActionUndefined(tc_request->tc_data.EvID));

            }

        } 

        return status;
    }

    //TC[19,4] allows enabling event-action definitions
    method exec19_4TC (&priv self, tc_request : &mut PS19TCRequest) -> Status<PUSService19Error> {

        var status : Status<PUSService19Error>;

        if (tc_request->tc_data.N != 1) {

            status = Failure(PUSService19Error::NumOfInstrNotValid(tc_request->tc_data.N));

        } else if (is_Ev_ID_valid(tc_request->tc_data.EvID) == false) {

            status = Failure(PUSService19Error::EvIDNotValid(tc_request->tc_data.EvID));

        } else {

            tc_request->ev_action_ID = self->is_ev_action_defined(tc_request->tc_data.EvID);

            if (tc_request->ev_action_ID.found){

                self->pus_service_1.notify_tm_1_3(
                        tc_request->tc_data.packet_id,
                        tc_request->tc_data.packet_seq_ctrl,
                        tc_request->tc_data.flags_ack);

                self->enable_event_action(tc_request->ev_action_ID.ev_action_index);

                self->pus_service_1.notify_tm_1_7(
                        tc_request->tc_data.packet_id,
                        tc_request->tc_data.packet_seq_ctrl,
                        tc_request->tc_data.flags_ack);

                status = Success;

            } else {

                status = Failure(PUSService19Error::EvActionUndefined(tc_request->tc_data.EvID));

            }
        }
                
        return status;
    }

    //TC[19,5] allows disabling event-action definitions
    method exec19_5TC (&priv self, tc_request : &mut PS19TCRequest) -> Status<PUSService19Error> {

        var status : Status<PUSService19Error>;


        if (tc_request->tc_data.N != 1) {

            status = Failure(PUSService19Error::NumOfInstrNotValid(tc_request->tc_data.N));

        }
        else if (is_Ev_ID_valid(tc_request->tc_data.EvID) == false) {

            status = Failure(PUSService19Error::EvIDNotValid(tc_request->tc_data.EvID));

        } else {

            tc_request->ev_action_ID =
                    self->is_ev_action_defined(tc_request->tc_data.EvID);

            if (tc_request->ev_action_ID.found) {

                    self->pus_service_1.notify_tm_1_3(
                            tc_request->tc_data.packet_id,
                            tc_request->tc_data.packet_seq_ctrl,
                            tc_request->tc_data.flags_ack);

                    self->disable_event_action(tc_request->ev_action_ID.ev_action_index);

                    self->pus_service_1.notify_tm_1_7(
                            tc_request->tc_data.packet_id,
                            tc_request->tc_data.packet_seq_ctrl,
                            tc_request->tc_data.flags_ack);

                    status = Success;

            } else {

                status = Failure(PUSService19Error::EvActionUndefined(tc_request->tc_data.EvID));

            }
            
        }

        return status;
    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler){

        var status : Status<PUSService19Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS19TCRequest = ps19_init_tc_request;

        tc_request.tc_data.packet_id = tc_handler->packet_header.packet_id;
        tc_request.tc_data.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.tc_data.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_data.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;

        var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.tc_data.N));

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u16_appdata_field(tc_handler, &mut (tc_request.tc_data.EvID));
        }

        if (tc_data_status is Failure) {
            status = Failure(PUSService19Error::AppDataOutOfRange(tc_request.tc_data.tc_num_bytes));
        }

        if ((status is Success) && subtype == 1
                && (tc_request.tc_data.tc_num_bytes < tc_handler->app_data_index + 2 + min_tc_size)) {
            status = Failure(PUSService19Error::AppDataOutOfRange(tc_request.tc_data.tc_num_bytes));
        }

        if ((status is Success) && subtype == 1) {

            tc_request.action_tc_packet.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes - 2 - tc_handler->app_data_index;
            
            for j : usize in 0 .. event_action_max_bytes while j < (tc_request.action_tc_packet.tc_num_bytes) {

                tc_request.action_tc_packet.tc_bytes[j] = tc_handler->tc_descriptor.tc_bytes[j + tc_handler->app_data_index];

            }

        }

        if (status is Success) {

            if (subtype == 1) {

                status = self->exec19_1TC(&mut tc_request);

            } else if (subtype == 2) {

                status = self->exec19_2TC(&mut tc_request);

            } else if (subtype == 4) {

                status = self->exec19_4TC(&mut tc_request);

            } else if (subtype == 5) {

                status = self->exec19_5TC(&mut tc_request);

            } else {

                status = Failure(PUSService19Error::ErrorInAcceptance);

            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                tc_num_bytes);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                N);

                    }
                    case EvIDNotValid(EvID) => {

                        self->pus_service_1.send_tm_1_4_EvID_not_valid(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                EvID);

                    }
                    case EvActionEnabled(EvID) => {

                        self->pus_service_1.send_tm_1_4_ev_action_enabled(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                EvID);

                    }
                    case EvActionRejected(EvID) => {

                        self->pus_service_1.send_tm_1_4_ev_action_rejected(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                EvID);

                    }
                    case EvActionUndefined(EvID) => {

                        self->pus_service_1.send_tm_1_4_ev_action_undefined(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                EvID);

                    }
                    case MaxEvActionsDefined(EvID) => {

                        self->pus_service_1.send_tm_1_8_max_ev_actions_defined(
                                tc_request.tc_data.packet_id,
                                tc_request.tc_data.packet_seq_ctrl,
                                EvID);

                    }
                }

            }
        }

        return;
    
    }
    
    procedure manage_event_action(&mut self, evID: u16){

        var found_and_id: FoundID = self->is_ev_action_defined(evID);

        if(found_and_id.found && found_and_id.enabled){


            var RID_type : Ev_IDType = get_Ev_ID_type(evID);

            match RID_type {

                case Informative => {
                    
                    if (self->pending_action_number[0] < event_action_queue_dimension){

                        var tail_index : usize = (self->pending_action_head[0] + self->pending_action_number[0])%event_action_queue_dimension;
                        self->pending_action_queue_1I[tail_index] = self->event_action_packets[found_and_id.ev_action_index];
                        self->pending_action_number[0] = self->pending_action_number[0] + 1;
                    }
                    else {
                        //error
                    }
            
                
                }
                case LowSeverityAnomaly => {

                    if (self->pending_action_number[1] < event_action_queue_dimension){

                        var tail_index : usize = (self->pending_action_head[1] + self->pending_action_number[1])%event_action_queue_dimension;
                        self->pending_action_queue_2LS[tail_index] = self->event_action_packets[found_and_id.ev_action_index];
                        self->pending_action_number[1] = self->pending_action_number[1] + 1;
                    }
                    else {
                        //error
                    }

                    
                }
                case MediumSeverityAnomaly => {

                    if (self->pending_action_number[2] < event_action_queue_dimension){

                        var tail_index : usize = (self->pending_action_head[2] + self->pending_action_number[2])%event_action_queue_dimension;
                        self->pending_action_queue_3MS[tail_index] = self->event_action_packets[found_and_id.ev_action_index];
                        self->pending_action_number[2] = self->pending_action_number[2] +1;
                    }
                    else {
                        //error
                    }

                    
                }
                case HighSeverityAnomaly => {

                    if (self->pending_action_number[3] < event_action_queue_dimension){

                        var tail_index : usize = (self->pending_action_head[3] + self->pending_action_number[3])%event_action_queue_dimension;
                        self->pending_action_queue_4HS[tail_index] = self->event_action_packets[found_and_id.ev_action_index];
                        self->pending_action_number[3] = self->pending_action_number[3] +1;
                    }
                    else {
                        //error
                    }

                
                }
                case Ev_IDNotValid => {

                    //error
                    
                }
            }

            
        }

        return;
    }
        
    procedure get_pending_action_number(&mut self, paction_num : &mut[usize;4]){

        for i: usize in 0 .. 3 {

            paction_num[i] = self->pending_action_number[i];

        }

        return;
    }

    procedure extract_action (&mut self, action_index : usize, action_packet : &mut TCHandler){

        if (action_index == 0){

            *action_packet = self->pending_action_queue_1I[self->pending_action_head[0]];
            self->pending_action_head[0] = (self->pending_action_head[0] + 1) % event_action_queue_dimension;
            self->pending_action_number[0] = self->pending_action_number[0] - 1;

        } else if (action_index == 1){

            *action_packet = self->pending_action_queue_2LS[self->pending_action_head[1]];
            self->pending_action_head[1] = (self->pending_action_head[1] + 1) % event_action_queue_dimension;
            self->pending_action_number[1] = self->pending_action_number[1] - 1;

        } else if (action_index == 2){

            *action_packet = self->pending_action_queue_3MS[self->pending_action_head[2]];
            self->pending_action_head[2] = (self->pending_action_head[2] + 1) % event_action_queue_dimension;
            self->pending_action_number[2] = self->pending_action_number[2] - 1;

        } else if (action_index == 3){

            *action_packet = self->pending_action_queue_4HS[self->pending_action_head[3]];
            self->pending_action_head[3] = (self->pending_action_head[3] + 1) % event_action_queue_dimension;
            self->pending_action_number[3] = self->pending_action_number[3] - 1;

        } else {
            //error
        } 

        return;

    }

};








