/*
PUS SERVICE 6 : MEMORY MANAGEMENT
*/


import obdh.pus.services.service6.internal;
import drivers.memory;



interface IPUSService6 {

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler);

};

resource class CPUSService6 provides IPUSService6 {

    memory : access IByteMemoryAccess;

    tm_channel : access ITMChannel;
    tm_handler_pool : access Allocator<TMHandler>;
    tm_counter : access ITMCounter;

    obt_manager : access IOBTManager;

    pus_service_1 : access IPUSService1;

    method check_memory_access(&self, tc_request : &PS6TCRequest, write : bool) -> Status<PUSService6Error> {

        var status : Status<PUSService6Error> = Success;

        var access_status : Status<MemAccessError> = Success;

        self->memory.check_access(tc_request->mem_id, tc_request->address as usize,
                                  tc_request->length as usize, write, &mut access_status);

        match access_status {
            case Success => {
            }
            case Failure(error) => {
                match error {
                    case InvalidAccess => {
                        status = Failure(PUSService6Error::MemAddressNotValid(tc_request->mem_id,
                                                                             tc_request->address));
                    }
                    case ReadOnly => {
                        status = Failure(PUSService6Error::MemIDReadOnly(tc_request->mem_id));
                    }
                }
            }
        }

        return status;
    }

    method exec6_2TC(&priv self, tc_request : &PS6TCRequest) -> Status<PUSService6Error> {

        var status : Status<PUSService6Error>;

        if (tc_request->N != 1) {

            status = Failure(PUSService6Error::NumOfInstrNotValid(tc_request->N));

        } else {

            status = self->check_memory_access(tc_request, true);

        }

        if (status is Success) {

            self->pus_service_1.notify_tm_1_3(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

            self->memory.write(tc_request->mem_id, tc_request->address as usize,
                               tc_request->length as usize, &tc_request->data);

            self->pus_service_1.notify_tm_1_7(
                    tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

        }

        return status;

    }

    method exec6_5TC(&priv self, tc_request : &mut PS6TCRequest) -> Status<PUSService6Error> {

        var status : Status<PUSService6Error>;

        if (tc_request->N != 1) {

            status = Failure(PUSService6Error::NumOfInstrNotValid(tc_request->N));

        } else {

            status = self->check_memory_access(&(*tc_request), false);

        }

        if (status is Success) {

            self->pus_service_1.notify_tm_1_3(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            self->memory.read(tc_request->mem_id, tc_request->address as usize,
                              tc_request->length as usize, &mut tc_request->data);

            var tm_handler : Option<box TMHandler> = None;
            self->tm_handler_pool.alloc(&mut tm_handler);

            match tm_handler {

                case Some(b_tm_handler) => {

                    var current_obt : CUCTime = {seconds = 0, finetime = 0};
                    var tm_count : u16 = 0 : u16;

                    self->tm_counter.get_next_tm_count(&mut tm_count);
                    self->obt_manager.get_current_obt(&mut current_obt);

                    let tm_status : Status<TMHandlerError> = build_tm_6_6(&mut b_tm_handler, tm_count, current_obt, &(*tc_request));

                    if (tm_status is Success){
                        self->tm_channel.send_tm(b_tm_handler);
                    } else {
                        self->tm_handler_pool.free(b_tm_handler);
                        status = Failure(PUSService6Error::AppDataOverflow);
                    }

                }
                case None => {

                    self->tm_counter.count_lost_tm();
                }
            }

            if (status is Success) {

                self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            }

        }

        return status;

    }

    method exec6_9TC(&priv self, tc_request : &PS6TCRequest) -> Status<PUSService6Error> {

        var status : Status<PUSService6Error>;

        if (tc_request->N != 1) {

            status = Failure(PUSService6Error::NumOfInstrNotValid(tc_request->N));

        } else {

            status = self->check_memory_access(tc_request, false);

        }

        if (status is Success) {

            self->pus_service_1.notify_tm_1_3(tc_request->packet_id,
                    tc_request->packet_seq_ctrl,
                    tc_request->flags_ack);

            var checksum : u16 = 0;
            self->memory.checksum(tc_request->mem_id, tc_request->address as usize,
                                  tc_request->length as usize, &mut checksum);

            var tm_handler : Option<box TMHandler> = None;
            self->tm_handler_pool.alloc(&mut tm_handler);

            match tm_handler {

                case Some(b_tm_handler) => {

                    var current_obt : CUCTime = {seconds = 0, finetime = 0};
                    var tm_count : u16 = 0 : u16;
                    self->tm_counter.get_next_tm_count(&mut tm_count);
                    self->obt_manager.get_current_obt(&mut current_obt);

                    let tm_status : Status<TMHandlerError> = build_tm_6_10(&mut b_tm_handler, tm_count, current_obt, tc_request, checksum);

                    if (tm_status is Success){
                        self->tm_channel.send_tm(b_tm_handler);
                    } else {
                        self->tm_handler_pool.free(b_tm_handler);
                        status = Failure(PUSService6Error::AppDataOverflow);
                    }

                }
                case None => {

                    self->tm_counter.count_lost_tm();
                }
            }

            if (status is Success) {

                self->pus_service_1.notify_tm_1_7(
                        tc_request->packet_id,
                        tc_request->packet_seq_ctrl,
                        tc_request->flags_ack);

            }

        }

        return status;

    }

    procedure exec_tc (&mut self, tc_handler : &mut TCHandler){

        var status : Status<PUSService6Error> = Success;
        var subtype : u8 = tc_handler->df_header.subtype;
        var tc_request : PS6TCRequest = ps6_init_tc_request;

        tc_request.packet_id = tc_handler->packet_header.packet_id;
        tc_request.packet_seq_ctrl = tc_handler->packet_header.packet_seq_ctrl;
        tc_request.flags_ack = tc_handler->df_header.flag_ver_ack;
        tc_request.tc_num_bytes = tc_handler->tc_descriptor.tc_num_bytes;

        var tc_data_status : Status<TCHandlerError> = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.mem_id));

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.N));
        }

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u32_appdata_field(tc_handler, &mut (tc_request.address));
        }

        if (tc_data_status is Success) {
            tc_data_status = tc_handler_get_u16_appdata_field(tc_handler, &mut (tc_request.length));
        }

        if ((tc_data_status is Success) && (subtype == 2)) {
            for j : usize in 0 .. max_memory_access_length while ((j < tc_request.length as usize) && (tc_data_status is Success)) {
                tc_data_status = tc_handler_get_u8_appdata_field(tc_handler, &mut (tc_request.data[j]));
            }
        }

        if (tc_data_status is Failure) {
            status = Failure(PUSService6Error::AppDataOutOfRange(tc_request.tc_num_bytes));
        }

        if (status is Success) {

            if (subtype == 2) {

                status = self->exec6_2TC(&tc_request);

            } else if (subtype == 5) {

                status = self->exec6_5TC(&mut tc_request);

            } else if (subtype == 9) {

                status = self->exec6_9TC(&tc_request);

            } else {

                status = Failure(PUSService6Error::ErrorInAcceptance);
            }

        }

        match status {

            case Success => {

            }
            case Failure(error) => {

                match error {

                    case ErrorInAcceptance => {

                        self->pus_service_1.send_tm_1_4_error_in_acceptance(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl);

                    }
                    case AppDataOutOfRange(tc_num_bytes) => {

                        self->pus_service_1.send_tm_1_4_short_pack_length(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                tc_num_bytes);

                    }
                    case AppDataOverflow => {

                        self->pus_service_1.send_tm_1_8_tm_exceed_limit_appdata(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl);

                    }
                    case NumOfInstrNotValid(N) => {

                        self->pus_service_1.send_tm_1_4_num_of_instr_not_valid(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                N);

                    }
                    case MemAddressNotValid(mem_id, address) => {

                        self->pus_service_1.send_tm_1_4_mem_address_not_valid(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                mem_id,
                                address);

                    }
                    case MemIDReadOnly(mem_id) => {

                        self->pus_service_1.send_tm_1_4_mem_id_read_only(
                                tc_request.packet_id,
                                tc_request.packet_seq_ctrl,
                                mem_id);

                    }
                }

            }
        }

        return;
    
    }

};