/**
 * @file pus_service12_help.fin
 * @brief Imports and definitions related to PUS Service 12.
 */

import obdh.obt_manager;
import obdh.pus.services.service5;

constexpr max_num_pmon_ids : usize = 16;
constexpr max_num_transitions : usize = 1;


enum MonitorCheckType {
    ExpectedValue, //0
    Limits,  //1
    Delta,  //2
    Free   //3
};

struct ParamValueCheckDefinition {
    mask_value : u32;
    expected_value : u32;
    EvID : u16;
};

struct ParamLimitCheckDefinition {
    low_limit : u32;
    low_limit_evID : u16;
    high_limit : u32;
    high_limit_evID : u16;
};

struct ParamDeltaCheckDefinition {
    low_delta_threshold : u16;
    low_delta_EvID : u16;
    high_delta_threshold : u16;
    high_delta_EvID : u16;
    consecutive_delta_values : u8;
};

enum MonitorDefinition {
    ParamValueCheck(ParamValueCheckDefinition),
    ParamLimitCheck(ParamLimitCheckDefinition),
    ParamDeltaCheck(ParamDeltaCheckDefinition),
    Unselected
};

// The outcome of running a check. A check that has not run yet is not one of
// these, it is the absence of one, which is why the state below wraps them in
// an Option: a monitor is either unchecked or holds one of these outcomes.
enum CheckValueResult {
    MonitorValueUnexpected, //2
    MonitorValueExpected  //3
};

enum CheckLimitsResult {
    MonitorAboveHighLimit,  //5
    MonitorBelowLowLimit,  //6
    MonitorWithinLimits  //7
};

enum CheckDeltaResult {
    MonitorDeltaLow,  //9
    MonitorDeltaHigh,  //10
    MonitorDeltaWithin  //11
};


// None is the monitor that has not been checked yet, and carries the index the
// MonitorUnchecked variant used to carry: 1, 4 and 8.
enum CheckState {
    ParamValueStatus(Option<CheckValueResult>),
    ParamLimitStatus(Option<CheckLimitsResult>),
    ParamDeltaStatus(Option<CheckDeltaResult>),
    Unselected //0
};


struct ParamMonitoringConfiguration {
    PID : u16;
    type : MonitorCheckType;
    enabled : bool;
    definition : MonitorDefinition;
    repetition: u8;
    repetition_control: u8;
    interval : u8;
    interval_control : u8;
    transition_obt : CUCTime;
    temp_state : CheckState;
    current_state : CheckState;
};


struct ParamMonitoringTransition {
    PMONID : u16;
    PID : u16;
    type : MonitorCheckType;
    mask_value : u32;
    limit_value : u32;
    new_value : u32;
    prev_status : CheckState;
    new_status : CheckState;
    trans_obt : CUCTime;

};

/**
 * @enum MonitoringOutcome
 * @brief What the check of a parameter monitor reports to do_monitoring.
 */
enum MonitoringOutcome {
    EventTriggered(u16, FaultInfo), /**< Transition that triggers an event, with its event ID and fault info */
    NoEvent,                        /**< Check completed without an event */
    NoReport                        /**< Monitor not checked, definition not matching its type or PID not in the data pool */
};


struct PS12TC_1_2_6_Data {
    N : u8;
    PMONID: u16;
};

struct PS12TC_5_Data {
    N : u8;
    PMONID: u16;
    mon_config : ParamMonitoringConfiguration;
};

/**
 * @enum PUSService12Error
 * @brief Reasons why PUS service 12 rejects a TC, with the data of the TM[1,4] that reports each one.
 */
enum PUSService12Error {
    ErrorInAcceptance,              /**< Subtype not supported */
    AppDataOutOfRange(usize),       /**< TC shorter than its fields, with its length in bytes */
    NumOfInstrNotValid(u8),         /**< Number of instructions other than 1 */
    PIDNotValid(u16),               /**< PID not defined in the system data pool */
    PMONUndefined(u16),             /**< Parameter monitor not defined */
    PMONIDInvalid(u16),             /**< Parameter monitor ID not valid */
    PMONDefinitionInvalid(u16),     /**< Parameter monitor definition not valid */
    PMONEnabled(u16)                /**< Parameter monitor enabled */
};

/**
 * @struct PS12TCRequest
 * @brief Fields of a TC[12,x] that its execution needs, decoded by exec_tc.
 */
struct PS12TCRequest {
    packet_id : u16;
    packet_seq_ctrl : u16;
    flags_ack : u8;
    tc_num_bytes : usize;
    tc_data_1_2_6: PS12TC_1_2_6_Data;
    tc_data_5: PS12TC_5_Data;  
};

constexpr ps12_init_tc_request : PS12TCRequest = {
    packet_id = 0,
    packet_seq_ctrl = 0,
    flags_ack = 0,
    tc_num_bytes = 0,
    tc_data_1_2_6 = {
        N = 0,
        PMONID = 0
    },
    tc_data_5 = {
        N = 0,
        PMONID = 0,
        mon_config = {
            PID = 0,
            type = MonitorCheckType::Free,
            enabled = false,
            definition = MonitorDefinition::Unselected,
            repetition= 0,
            repetition_control= 0,
            interval = 0,
            interval_control = 0,
            transition_obt = {seconds = 0, finetime = 0},
            temp_state = CheckState::Unselected,
            current_state = CheckState::Unselected
        }
    }
};


    

function get_check_status_index (status : CheckState) -> u8 {

    var status_index : u8 = 0;

    match status {

        case ParamValueStatus(param_status) => {

            match param_status {

                case None => {
                    status_index = 1;
                }
                case Some(result) => {

                    match result {

                        case MonitorValueUnexpected => {
                            status_index = 2;
                        }
                        case MonitorValueExpected => {
                            status_index = 3;
                        }
                    }
                }
            }

        }
        case ParamLimitStatus(limit_status) => {

            match limit_status {

                case None => {
                    status_index = 4;
                }
                case Some(result) => {

                    match result {

                        case MonitorAboveHighLimit => {
                            status_index = 5;
                        }
                        case MonitorBelowLowLimit => {
                            status_index = 6;
                        }
                        case MonitorWithinLimits => {
                            status_index = 7;
                        }
                    }
                }
            }

        }
        case ParamDeltaStatus(delta_status) => {

            match delta_status {

                case None => {
                    status_index = 8;
                }
                case Some(result) => {

                    match result {

                        case MonitorDeltaLow => {
                            status_index = 9;
                        }
                        case MonitorDeltaHigh => {
                            status_index = 10;
                        }
                        case MonitorDeltaWithin => {
                            status_index = 11;
                        }
                    }
                }
            }

        }
        case Unselected => {

        }
    }

    return status_index;
}

function get_type_index (type : MonitorCheckType) -> u8 {

    var type_index : u8;

    match type {

        case ExpectedValue => {
            type_index = 0;
        }
        case Limits => {
            type_index = 1;
        }
        case Delta => {
            type_index = 2;
        }
        case Free => {
            type_index = 0xFF;
        }
    }

    return type_index;
}


function are_status_equal (status1 : CheckState, status2 : CheckState) -> bool {

    var equal : bool = get_check_status_index(status1) == get_check_status_index(status2);

    return equal;
}



function is_PMONID_valid(PMONID : u16) -> bool {

    var is_valid : bool = false;

    if (PMONID as usize < max_num_pmon_ids) {

        is_valid = true;
    }

    return is_valid;
}


function get_check_type (aux : u8) -> MonitorCheckType {

    var monitor_check : MonitorCheckType;

    if (aux == 0) {

        monitor_check = MonitorCheckType::ExpectedValue;

    } else if (aux == 1) {

        monitor_check = MonitorCheckType::Limits;

    } else if (aux == 2) {

        monitor_check = MonitorCheckType::Delta;

    } else {

        monitor_check = MonitorCheckType::Free;

    }

    return monitor_check;
}


function is_valid_check_limit_def (param_limit_check_definition : &MonitorDefinition) -> bool {

    var res : bool = false;

    match *param_limit_check_definition {

        case ParamLimitCheck(param_limit_def) => {

            if (param_limit_def.low_limit < param_limit_def.high_limit) {

                res = true;

            }
        }
        case _ => {

            res = false;

        }
    }
    return res;
}


function build_tm_12_12(p_tm_handler : &mut TMHandler, tm_seq_counter : u16, current_obt : CUCTime, counter: u8, param_mon_transitions_table : &[ParamMonitoringTransition; max_num_transitions]) -> Status<TMHandlerError> {

    startup_tm(p_tm_handler);
    var status : Status<TMHandlerError> = append_u8_appdata_field(p_tm_handler, counter);

    for i : usize in 0 .. max_num_transitions while (i < (counter as usize)) {

        if (status is Success) {
            status = append_u16_appdata_field(p_tm_handler, param_mon_transitions_table[i].PMONID);
        }
        if (status is Success) {
            status = append_u16_appdata_field(p_tm_handler, param_mon_transitions_table[i].PID);
        }
        if (status is Success) {
            var type_id : u8 = get_type_index(param_mon_transitions_table[i].type);
            status = append_u8_appdata_field(p_tm_handler, type_id);
        }
        
        
        if(param_mon_transitions_table[i].type is MonitorCheckType::ExpectedValue && (status is Success)) {
            status = append_u32_appdata_field(p_tm_handler, param_mon_transitions_table[i].mask_value);
        }

        var aux_prev_status : u8 = get_check_status_index(param_mon_transitions_table[i].prev_status);
        var aux_new_status : u8 = get_check_status_index(param_mon_transitions_table[i].new_status);

        if (status is Success) {
            status = append_u32_appdata_field(p_tm_handler, param_mon_transitions_table[i].new_value);
        }
        if (status is Success) {
            status = append_u32_appdata_field(p_tm_handler, param_mon_transitions_table[i].limit_value);
        }
        if (status is Success) {
            status = append_u8_appdata_field(p_tm_handler, aux_prev_status);
        }
        if (status is Success) {
            status = append_u8_appdata_field(p_tm_handler, aux_new_status);
        }
        if (status is Success) {
            status = append_u32_appdata_field(p_tm_handler, param_mon_transitions_table[i].trans_obt.seconds); 
        }
    }
    if(status is Success){
        close_tm(p_tm_handler, 12, 12, tm_seq_counter, current_obt);
    }


    return status;
}