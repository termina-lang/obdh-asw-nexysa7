/**
 * @file pus_service4_help.fin
 * @brief Imports and definitions related to PUS Service 4.
 */

import obdh.pus.services.service1;
import obdh.tmtc.tm_channel;
import obdh.obt_manager;

constexpr max_num_of_stats : usize = 4;

struct StatsDef {
    min : u32;
    min_obt : CUCTime;
    max : u32;
    max_obt : CUCTime;
    mean_value : u32;
    samples : u32;
};

struct StatsConfig {
    defined : [bool; max_num_of_stats];
    PID : [u16; max_num_of_stats];
    start_time : [CUCTime; max_num_of_stats];
};

/**
 * @struct PS4TCRequest
 * @brief Fields of a TC[4,x] that its execution needs, decoded by exec_tc, and the index of the statistics it works on.
 */
struct PS4TCRequest {
    packet_id : u16;
    packet_seq_ctrl : u16;
    flags_ack : u8;
    tc_num_bytes : usize;
    N: u8;
    PID: u16;
    valid_index : usize;
};

constexpr ps4_init_tc_request : PS4TCRequest = {
    packet_id = 0,
    packet_seq_ctrl = 0,
    flags_ack = 0,
    tc_num_bytes = 0,
    N = 0,
    PID = 0,
    valid_index = 0
};

/**
 * @enum PUSService4Error
 * @brief Reasons why PUS service 4 rejects or fails a TC, with the data of the TM[1,4] or TM[1,8] that reports each one.
 */
enum PUSService4Error {
    ErrorInAcceptance,          /**< Subtype not supported */
    AppDataOutOfRange(usize),   /**< TC shorter than its fields, with its length in bytes */
    NumOfInstrNotValid(u8),     /**< Number of instructions other than 1 */
    PIDNotValid(u16),           /**< PID not defined in the system data pool */
    PIDStatsUndefined(u16),     /**< No statistics defined for the PID */
    NotFreeStatsConfig(u16)     /**< No free statistics slot for the PID */
};

struct IndexStatus {
    index : usize;
    status : Status<PUSService4Error>;
};


function build_tm_4_2(p_tm_handler : &mut TMHandler, tm_seq_counter : u16, stats_index: usize, N : u8, stats_config_table : &StatsConfig, param_stats : &[StatsDef; max_num_of_stats], current_obt: CUCTime) -> Status<TMHandlerError> {

    startup_tm(p_tm_handler);

    var status : Status<TMHandlerError> = append_u32_appdata_field(p_tm_handler, stats_config_table->start_time[stats_index].seconds);
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, current_obt.seconds);
    }
    if (status is Success) {
        status = append_u8_appdata_field(p_tm_handler, N);
    }
    if (status is Success) {
        status = append_u16_appdata_field(p_tm_handler, stats_config_table->PID[stats_index]);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].samples);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].max);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].max_obt.seconds);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].min);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].min_obt.seconds);
    }
    if (status is Success) {
        status = append_u32_appdata_field(p_tm_handler, param_stats[stats_index].mean_value);
    }

    if(status is Success) {
        close_tm(p_tm_handler, 4, 2, tm_seq_counter, current_obt);
    }

    return status;
}
