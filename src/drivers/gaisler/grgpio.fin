import drivers.gpio;

/**
 * @brief Structure representing the GRGPIO hardware registers.
 *
 * Contains the registers for data, output, and direction control of GPIO pins.
 */
struct GPIO_registers {
    /// Data register (32-bit)
    Data : u32;
    /// Output register (32-bit)
    Output : u32;
    /// Direction register (32-bit), defines pin direction (input/output)
    Direction : u32;
};

/**
 * @interface IGRGPIOInit
 * @brief Initialization of the GRGPIO driver.
 */
interface IGRGPIOInit {
    procedure init_gpio(&mut self);
};

/**
 * @brief Driver of the Gaisler GRGPIO, a single port of up to 32 pins.
 *
 * Pins are identified by port 0 and their bit in the registers.
 */
resource class CGRGPIODriver provides IGPIO, IGRGPIOInit {

    /// Memory-mapped access to GPIO registers (e.g., 0xfc083000)
    registers: loc GPIO_registers;

    /// Pins configured as outputs, one bit each
    output_mask : u32;

    /**
     * @brief Configures as outputs the pins of output_mask.
     */
    procedure init_gpio(&mut self) {

        self->registers.Direction = self->registers.Direction | self->output_mask;

        return;
    }

    procedure write_pin(&mut self, pin : GPIOPinId, state : GPIOPinState) {

        let bit : u32 = 1 << (pin.pin as u32);

        match state {
            case Low => {
                self->registers.Output = self->registers.Output & (0xFFFFFFFF ^ bit);
            }
            case High => {
                self->registers.Output = self->registers.Output | bit;
            }
        }

        return;
    }

    procedure toggle_pin(&mut self, pin : GPIOPinId) {

        self->registers.Output = self->registers.Output ^ (1 << (pin.pin as u32));

        return;
    }

    procedure read_pin(&mut self, pin : GPIOPinId, state : &mut GPIOPinState) {

        if ((self->registers.Data & (1 << (pin.pin as u32))) != 0 : u32) {
            *state = GPIOPinState::High;
        } else {
            *state = GPIOPinState::Low;
        }

        return;
    }

};
