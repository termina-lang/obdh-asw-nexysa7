/**
 * @enum GPIOPinState
 * @brief Level of a GPIO pin.
 */
enum GPIOPinState {
    Low,
    High
};

/**
 * @struct GPIOPinId
 * @brief A pin of the board, as a port and the pin within it. Each driver
 * numbers its ports and pins as its hardware does.
 */
struct GPIOPinId {
    port : usize;
    pin : usize;
};

/**
 * @interface IGPIO
 * @brief Reading and writing of GPIO pins already configured by the driver
 * of the board.
 */
interface IGPIO {

    /**
     * @brief Drives an output pin to a level.
     * @param[in] pin Pin to write.
     * @param[in] state Level to drive.
     */
    procedure write_pin(&mut self, pin : GPIOPinId, state : GPIOPinState);

    /**
     * @brief Inverts the level of an output pin.
     * @param[in] pin Pin to toggle.
     */
    procedure toggle_pin(&mut self, pin : GPIOPinId);

    /**
     * @brief Reads the level of a pin.
     * @param[in] pin Pin to read.
     * @param[out] state Level read.
     */
    procedure read_pin(&mut self, pin : GPIOPinId, state : &mut GPIOPinState);

};
