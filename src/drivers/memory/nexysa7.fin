import drivers.memory;
import checksum.crc16;

/**
 * Memory regions of the Nexys A7: the DDR2 from 0x40000000, split in eight
 * banks of 16 MB numbered as the memory identifiers of the telecommands:
 * bank n starts at 0x40000000 + n * 0x01000000. Bank 0 holds the image.
 */
constexpr nexysa7_ddr2_base : usize = 0x40000000 : usize;
constexpr nexysa7_num_banks : usize = 8 : usize;
constexpr nexysa7_bank_size : usize = 1 << 24 : usize;

resource class CNexysA7Memory provides IByteMemoryAccess {

    // Placed at nexysa7_ddr2_base
    ddr2 : loc [[u8; nexysa7_bank_size]; nexysa7_num_banks];

    // Write permission of each bank, indexed by its memory identifier
    write_enabled : [bool; nexysa7_num_banks];

    procedure check_access(&self, mem_id : u8, address : usize, length : usize,
                           write : bool, result : &mut Status<MemAccessError>) {

        if (mem_id as usize < nexysa7_num_banks) {

            let bank_start : usize = nexysa7_ddr2_base + (mem_id as usize) * nexysa7_bank_size;

            if ((length > max_memory_access_length)
                    || (address < bank_start)
                    || (address - bank_start >= nexysa7_bank_size)
                    || (length > nexysa7_bank_size - (address - bank_start))) {

                *result = Failure(MemAccessError::InvalidAccess);

            } else if (write) {

                if (self->write_enabled[mem_id as usize]) {
                    *result = Success;
                } else {
                    *result = Failure(MemAccessError::ReadOnly);
                }

            } else {

                *result = Success;

            }

        } else {

            *result = Failure(MemAccessError::InvalidAccess);

        }

        return;
    }

    procedure read(&self, mem_id : u8, address : usize, length : usize,
                   dst : &mut [u8; max_memory_access_length]) {

        let offset : usize = address - nexysa7_ddr2_base - (mem_id as usize) * nexysa7_bank_size;

        for i : usize in 0 : usize .. max_memory_access_length while (i < length) {
            (*dst)[i] = self->ddr2[mem_id as usize][offset + i];
        }

        return;
    }

    procedure write(&mut self, mem_id : u8, address : usize, length : usize,
                    src : &[u8; max_memory_access_length]) {

        let offset : usize = address - nexysa7_ddr2_base - (mem_id as usize) * nexysa7_bank_size;

        for i : usize in 0 : usize .. max_memory_access_length while (i < length) {
            self->ddr2[mem_id as usize][offset + i] = (*src)[i];
        }

        return;
    }

    procedure checksum(&self, mem_id : u8, address : usize, length : usize,
                       checksum : &mut u16) {

        var crc : u16 = crc16_initial;
        let offset : usize = address - nexysa7_ddr2_base - (mem_id as usize) * nexysa7_bank_size;

        for i : usize in 0 : usize .. max_memory_access_length while (i < length) {
            crc = crc16_update(crc, self->ddr2[mem_id as usize][offset + i]);
        }

        *checksum = crc;

        return;
    }

};
