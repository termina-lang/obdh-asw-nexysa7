/**
 * @interface ICharDev
 * @brief Byte-level access to a character device.
 *
 * Every operation reads or writes the registers of the device and nothing
 * else: the device keeps no buffer and knows nothing of what it carries. The
 * operations on data and the ones on the transmit interrupt are kept apart.
 */
interface ICharDev {

    /**
     * @brief Reads the received byte, if there is one.
     * @param[out] byte Received byte, or None.
     */
    procedure read_byte(&mut self, byte : &mut Option<u8>);

    /**
     * @brief Tells whether the transmitter can take a new byte.
     * @param[out] ready True if the transmit register is empty.
     */
    procedure tx_ready(&mut self, ready : &mut bool);

    /**
     * @brief Writes a byte to the transmit register.
     * @param[in] byte Byte to transmit.
     */
    procedure write_byte(&mut self, byte : u8);

    /**
     * @brief Enables the interrupt raised when the transmitter can take a new byte.
     */
    procedure enable_tx_irq(&mut self);

    /**
     * @brief Disables the transmit interrupt. A byte already written is still sent.
     */
    procedure disable_tx_irq(&mut self);

};
